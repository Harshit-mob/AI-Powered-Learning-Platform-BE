    ],
    "summary": "\u0aaa\u0abe\u0aa0 \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0ab2\u0ac7\u0a96\u0abf\u0aa4 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8.",
    "subtopic_title": "\u0ab2\u0ac7\u0a96\u0abf\u0aa4 \u0ab8\u0acd\u0ab5\u0abe\u0aa7\u0acd\u0aaf\u0abe\u0aaf"
  },
  {
    "title": "\u0a9c\u0acb\u0aa1\u0aa3\u0ac0 \u0a85\u0aa8\u0ac7 \u0a96\u0abe\u0ab2\u0ac0 \u0a9c\u0a97\u0acd\u0aaf\u0abe",
    "content": "\u0ae7. \u0a93\u0aa2\u0aa3\u0ac0, \u0a93\u0aa2\u0aa3\u0ac0, \u0a93\u0aa2\u0aa8\u0abf. \u0ae8. \u0a95\u0acb\u0a88\u0ab2, \u0a95\u0acc\u0aaf\u0ab2, \u0a95\u0acb\u0aaf\u0ab2. \u0ae9. \u0aad\u0abf\u0a95\u0acd\u0ab7\u0abe\u0a85\u0aa8\u0acd\u0aa8, \u0aad\u0abf\u0a95\u0acd\u0ab7\u0abe\u0aa8\u0acd\u0aa8, \u0aad\u0abf\u0a95\u0acd\u0ab7\u0abe\u0aa8\u0aa8. \u0ae7. \u0a95\u0ac3\u0ab7\u0acd\u0aa3\u0ab5\u0ab0\u0acd\u0aae\u0abe \u0aa8\u0a97\u0ab0\u0ab6\u0ac7\u0aa0\u0aa8\u0ac7 \u0a98\u0ac7\u0ab0..................... \u0a95\u0ab0\u0aa4\u0acb \u0aac\u0abe\u0ab0\u0aa3\u0ac7 \u0a8a\u0aad\u0acb \u0ab0\u0ab9\u0acd\u0aaf\u0acb. \u0ae8. \u0aae\u0a9f\u0acd\u0a9f\u0ac2\u0ab0 \u0a97\u0abe\u0aae\u0aa8\u0ac0 \u0ab6\u0ac7\u0ab0\u0ac0\u0a93\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0ab8\u0abe\u0ab0 \u0aa5\u0aa4\u0abe\u0a82.......................\u0aa8\u0abe \u0a85\u0ab5\u0abe\u0a9c \u0ab8\u0abe\u0a82\u0aad\u0ab3\u0ab5\u0abe \u0aae\u0ab3\u0ac7 \u0a9b\u0ac7.",
    "learning_objective": "\u0a9c\u0acb\u0aa1\u0aa3\u0ac0 \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0ab5\u0ac0",
