    "summary": "\u0a97\u0ac1\u0ab0\u0ac1\u0a95\u0ac1\u0ab3\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0aa6\u0acd\u0aaf\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0a93\u0aa8\u0ac7 \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0ae8\u0ae6 \u0aa6\u0abf\u0ab5\u0ab8\u0aae\u0abe\u0a82 \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4 \u0aad\u0abe\u0ab7\u0abe \u0ab6\u0ac0\u0a96\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.",
    "subtopic_title": "\u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4 \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3\u0aa8\u0ac0 \u0a9d\u0aa1\u0aaa"
  },
  {
    "title": "\u0ab6\u0aac\u0acd\u0aa6\u0abe\u0ab0\u0acd\u0aa5 \u0a85\u0aa8\u0ac7 \u0ab8\u0aae\u0a9c\u0ac2\u0aa4\u0ac0",
    "content": "\u0ab8\u0a82\u0aaa\u0aa8\u0acd\u0aa8 = \u0aad\u0ab0\u0aaa\u0ac2\u0ab0, \u0aaa\u0ac1\u0ab7\u0acd\u0a95\u0ab3. \u0aa8\u0abf\u0ab0\u0acd\u0aae\u0ab3 = \u0aaa\u0ab5\u0abf\u0aa4\u0acd\u0ab0. \u0ab6\u0abf\u0a96\u0abe = \u0a9a\u0acb\u0a9f\u0ab2\u0ac0. \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0 = \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0ac0, \u0ab5\u0a9f\u0ac7\u0aae\u0abe\u0ab0\u0acd\u0a97\u0ac1. \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 = \u0a85\u0ab8\u0acd\u0aa4\u0abf\u0aa4\u0acd\u0ab5\u0aae\u0abe\u0a82 \u0ab9\u0acb\u0ab5\u0ac1\u0a82. \u0aaa\u0a9b\u0abe\u0aa4 = \u0aaa\u0abe\u0a9b\u0ab3 \u0aaa\u0aa1\u0ac7\u0ab2\u0ac1\u0a82. \u0aaa\u0ab0\u0a82\u0aaa\u0ab0\u0abe = \u0aaa\u0acd\u0ab0\u0aa5\u0abe. \u0ab5\u0ac8\u0aa6\u0abf\u0a95 \u0a95\u0abe\u0ab3 = \u0ab5\u0ac7\u0aa6\u0acb\u0aa8\u0acb \u0a95\u0abe\u0ab3. \u0a97\u0ac1\u0ab0\u0ac1\u0a95\u0ac1\u0ab3 = \u0ab6\u0abe\u0ab3\u0abe. \u0ab8\u0aae\u0aaf = \u0ab5\u0a96\u0aa4. \u0ab6\u0ac7\u0ab0\u0ac0 = \u0a97\u0ab2\u0ac0. \u0a9d\u0abe\u0aa1 = \u0ab5\u0ac3\u0a95\u0acd\u0ab7, \u0aa4\u0ab0\u0ac1, \u0aa6\u0acd\u0ab0\u0ac1\u0aae, \u0aaa\u0abe\u0aa6\u0aaa. \u0ab5\u0acd\u0aaf\u0ab5\u0ab8\u0acd\u0aa5\u0abe = \u0aaa\u0acd\u0ab0\u0aac\u0a82\u0aa7.",
    "learning_objective": "\u0ab6\u0aac\u0acd\u0aa6\u0abe\u0ab0\u0acd\u0aa5\u0acb\u0aa8\u0ac1\u0a82 \u0a9c\u0acd\u0a9e\u0abe\u0aa8 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0ac1\u0a82.",
