  {
    "title": "\u0928\u093f\u0936\u093e\u0928\u0947\u092c\u093e\u091c\u0940 \u0915\u093e \u0915\u094c\u0936\u0932",
    "content": "\u0917\u0928 \u0938\u0947 \u0938\u094b\u0932\u0939 \u0906\u0928\u093e \u0938\u091f\u0940\u0915 \u0928\u093f\u0936\u093e\u0928\u093e \u0932\u0917\u0924\u093e \u0925\u093e\u0964 \u0915\u0941\u091b \u0939\u0940 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0917\u0928 \u0938\u0947 \u0916\u0942\u092c \u092f\u093e\u0930\u0940 \u092d\u0940 \u0939\u094b \u0917\u0908\u0964 \u091c\u092c \u0906\u0938\u092a\u093e\u0938 \u0928\u093f\u0936\u093e\u0928\u0947\u092c\u093e\u091c\u0940 \u0915\u0947 \u092e\u0941\u0915\u093e\u092c\u0932\u0947 \u0939\u094b\u0924\u0947 \u0925\u0947, \u0924\u092c \u0909\u0928\u092e\u0947\u0902 \u092d\u093e\u0917 \u0932\u0947\u0928\u0947 \u0915\u093e... \u092e\u091c\u093e \u0939\u0940 \u0905\u0932\u0939\u0926\u093e \u0939\u094b\u0924\u093e \u0925\u093e\u0964 \u0924\u092c \u0924\u092f \u0932\u0917 \u0930\u0939\u093e \u0925\u093e \u0915\u093f \u092d\u093e\u0902\u091c\u093e \u0906\u0917\u0947 \u091a\u0932\u0915\u0930 \u092e\u093e\u092e\u093e \u0938\u0947 \u092d\u0940 \u092e\u093e\u0939\u093f\u0930 \u0928\u093f\u0936\u093e\u0928\u0947\u092c\u093e\u091c \u092c\u0928\u0947\u0917\u093e\u0964 \u0928\u093f\u0936\u093e\u0928\u093e \u0907\u0924\u0928\u093e \u092a\u0915\u094d\u0915\u093e \u0932\u0917\u0924\u093e \u0925\u093e \u0915\u093f \u0932\u094b\u0917 \u0926\u093e\u0901\u0924\u094b\u0902 \u0924\u0932\u0947 \u0909\u0902\u0917\u0932\u0940 \u0926\u092c\u093e \u0932\u0947\u0924\u0947 \u0925\u0947\u0964",
    "learning_objective": "\u092e\u0941\u0939\u093e\u0935\u0930\u094b\u0902 \u0914\u0930 \u092d\u093e\u0937\u093e \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0938\u092e\u091d\u0928\u093e",
