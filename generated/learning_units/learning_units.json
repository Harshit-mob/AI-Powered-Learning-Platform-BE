  {
    "title": "\u092e\u093e\u092e\u093e \u0914\u0930 \u092d\u093e\u0902\u091c\u0947 \u0915\u093e \u0936\u093f\u0915\u093e\u0930 \u092a\u094d\u0930\u0947\u092e",
    "content": "\u092e\u093e\u092e\u093e \u092c\u095c\u0947 \u0936\u093f\u0915\u093e\u0930\u0940 \u0925\u0947\u0964 \u092e\u093e\u092e\u093e \u0928\u0947 \u092d\u093e\u0902\u091c\u0947 \u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u090f\u0915 \u0917\u0928 \u0916\u0930\u0940\u0926 \u0926\u0940 \u0925\u0940\u0964 \u0917\u0928 \u0915\u093e \u0930\u0941\u0924\u092c\u093e \u0939\u0940 \u0905\u0932\u0917 \u0925\u093e\u0964 \u0924\u092c \u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u092c\u091a\u094d\u091a\u0947 \u092a\u0924\u094d\u0925\u0930 \u092b\u0947\u0902\u0915\u0915\u0930 \u0939\u0940 \u0928\u093f\u0936\u093e\u0928\u093e \u0938\u093e\u0927\u0924\u0947 \u0925\u0947, \u0915\u0908 \u092c\u091a\u094d\u091a\u0947 \u0917\u0941\u0932\u0947\u0932 \u0938\u0947 \u0928\u093f\u0936\u093e\u0928\u091a\u0940 \u092c\u0928\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0924\u0947 \u0925\u0947, \u0932\u0947\u0915\u093f\u0928 \u092d\u093e\u0902\u091c\u0947 \u0915\u0947 \u092a\u093e\u0938 \u0924\u094b \u0906\u0920-\u0928\u094c \u0938\u093e\u0932 \u0915\u0940 \u0909\u092e\u094d\u0930 \u092e\u0947\u0902 \u0939\u0940 \u0917\u0928 \u0906 \u0917\u0908 \u0925\u0940\u0964",
    "learning_objective": "\u0915\u0939\u093e\u0928\u0940 \u0915\u0947 \u092a\u093e\u0924\u094d\u0930\u094b\u0902 \u0914\u0930 \u092a\u0930\u093f\u0935\u0947\u0936 \u0915\u093e \u091c\u094d\u091e\u093e\u0928",
