  {
    "title": "\u0ab2\u0abf\u0a82\u0a97\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0",
    "content": "\u0aa8\u0ab0\u0a9c\u0abe\u0aa4\u0abf, \u0aa8\u0abe\u0ab0\u0ac0\u0a9c\u0abe\u0aa4\u0abf \u0a85\u0aa8\u0ac7 \u0aa8\u0abe\u0aa8\u0acd\u0aaf\u0aa4\u0ab0 \u0a9c\u0abe\u0aa4\u0abf\u0aa8\u0acb \u0aa8\u0abf\u0ab0\u0acd\u0aa6\u0ac7\u0ab6 \u0a95\u0ab0\u0aa4\u0ac0 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe\u0a93\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0abe\u0a95\u0ab0\u0aa3\u0aa8\u0ac0 \u0aaa\u0ab0\u0abf\u0aad\u0abe\u0ab7\u0abe\u0aae\u0abe\u0a82 \u0a85\u0aa8\u0ac1\u0a95\u0acd\u0ab0\u0aae\u0ac7 \u0aaa\u0ac1\u0ab2\u0acd\u0ab2\u0abf\u0a82\u0a97, \u0ab8\u0acd\u0aa4\u0acd\u0ab0\u0ac0\u0ab2\u0abf\u0a82\u0a97 \u0a85\u0aa8\u0ac7 \u0aa8\u0aaa\u0ac1\u0a82\u0ab8\u0a95\u0ab2\u0abf\u0a82\u0a97\u0aa8\u0ac0 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe\u0a93 \u0a95\u0ab9\u0ac7 \u0a9b\u0ac7. \u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 '\u0a93' \u0aaa\u0ac1\u0ab2\u0acd\u0ab2\u0abf\u0a82\u0a97\u0aa8\u0ac1\u0a82 \u0a9a\u0abf\u0ab9\u0acd\u0aa8 \u0a9b\u0ac7. '\u0a88' \u0ab8\u0acd\u0aa4\u0acd\u0ab0\u0ac0\u0ab2\u0abf\u0a82\u0a97\u0aa8\u0ac1\u0a82 \u0a9a\u0abf\u0ab9\u0acd\u0aa8 \u0a9b\u0ac7. '\u0a89' \u0aa8\u0aaa\u0ac1\u0a82\u0ab8\u0a95\u0ab2\u0abf\u0a82\u0a97\u0aa8\u0ac1\u0a82 \u0a9a\u0abf\u0ab9\u0acd\u0aa8 \u0a9b\u0ac7. \u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0a95\u0ac1\u0aa4\u0ab0\u0acb (\u0aaa\u0ac1\u0ab2\u0acd\u0ab2\u0abf\u0a82\u0a97), \u0ab0\u0abe\u0aa3\u0ac0 (\u0ab8\u0acd\u0aa4\u0acd\u0ab0\u0ac0\u0ab2\u0abf\u0a82\u0a97), \u0a98\u0ac7\u0a9f\u0ac1\u0a82 (\u0aa8\u0aaa\u0ac1\u0a82\u0ab8\u0a95\u0ab2\u0abf\u0a82\u0a97).",
    "learning_objective": "\u0ab2\u0abf\u0a82\u0a97\u0aa8\u0ac0 \u0a93\u0ab3\u0a96 \u0a95\u0ab0\u0ab5\u0ac0",
    "keywords": [
      "\u0aaa\u0ac1\u0ab2\u0acd\u0ab2\u0abf\u0a82\u0a97",
      "\u0ab8\u0acd\u0aa4\u0acd\u0ab0\u0ac0\u0ab2\u0abf\u0a82\u0a97",
      "\u0aa8\u0aaa\u0ac1\u0a82\u0ab8\u0a95\u0ab2\u0abf\u0a82\u0a97",
      "\u0ab2\u0abf\u0a82\u0a97"
    ],
    "difficulty": 3,
    "estimated_reading_time": 120,
    "source_pages": [
      7
    ],
    "summary": "\u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4\u0ac0 \u0ab5\u0acd\u0aaf\u0abe\u0a95\u0ab0\u0aa3\u0aae\u0abe\u0a82 \u0ab2\u0abf\u0a82\u0a97\u0aa8\u0abe \u0aa4\u0acd\u0ab0\u0aa3 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0\u0acb\u0aa8\u0ac0 \u0ab8\u0aae\u0a9c\u0ac2\u0aa4\u0ac0.",
    "subtopic_title": "\u0ab2\u0abf\u0a82\u0a97\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0"
  },
  {
    "title": "\u0aae\u0acc\u0a96\u0abf\u0a95 \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb",
    "content": "\u0ae7. \u0ab5\u0ac8\u0aa6\u0abf\u0a95 \u0a95\u0abe\u0ab3 \u0aa6\u0ab0\u0aae\u0abf\u0aaf\u0abe\u0aa8 \u0a97\u0ac1\u0ab0\u0ac1\u0a95\u0ac1\u0ab3 \u0aaa\u0ab0\u0a82\u0aaa\u0ab0\u0abe \u0a85\u0a82\u0aa4\u0ab0\u0acd\u0a97\u0aa4 \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aa4\u0ac1\u0a82 \u0ab9\u0aa4\u0ac1\u0a82? \u0ae8. \u0ab5\u0abf\u0aa6\u0acd\u0aaf\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0a93\u0a8f (\u0ab6\u0abf\u0ab7\u0acd\u0aaf\u0acb\u0aa8\u0ac7) \u0aa4\u0ac7 \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acd\u0aaf\u0abe\u0a82 \u0a9c\u0a88\u0aa8\u0ac7 \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0ac1\u0a82 \u0aaa\u0aa1\u0aa4\u0ac1\u0a82 \u0ab9\u0aa4\u0ac1\u0a82? \u0ae9. \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aae\u0abe\u0aa4\u0ac3\u0aad\u0abe\u0ab7\u0abe \u0a95\u0a88 \u0a9b\u0ac7? \u0a9a\u0ab0\u0acd\u0a9a\u0abe \u0a95\u0ab0\u0acb.",
    "learning_objective": "\u0aae\u0acc\u0a96\u0abf\u0a95 \u0a85\u0aad\u0abf\u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf",
    "keywords": [
      "\u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb",
      "\u0a85\u0aad\u0acd\u0aaf\u0abe\u0ab8",
      "\u0a9a\u0ab0\u0acd\u0a9a\u0abe"
    ],
    "difficulty": 2,
    "estimated_reading_time": 60,
    "source_pages": [
      3
    ],
    "summary": "\u0aaa\u0abe\u0aa0\u0aa8\u0abe \u0ab8\u0abe\u0ab0\u0abe\u0a82\u0ab6\u0aa8\u0ac7 \u0ab8\u0aae\u0a9c\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0abe \u0aae\u0acc\u0a96\u0abf\u0a95 \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb.",
    "subtopic_title": "\u0aae\u0acc\u0a96\u0abf\u0a95 \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb"
  },
  {
    "title": "\u0ab2\u0ac7\u0a96\u0abf\u0aa4 \u0ab8\u0acd\u0ab5\u0abe\u0aa7\u0acd\u0aaf\u0abe\u0aaf",
    "content": "\u0ae7. \u0a86\u0aaa\u0ac7\u0ab2\u0ac0 \u0a95\u0ac3\u0aa4\u0abf\u0aae\u0abe\u0a82 \u0a95\u0aaf\u0abe \u0a97\u0abe\u0aae \u0ab5\u0abf\u0ab6\u0ac7 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0a86\u0aaa\u0ac0 \u0a9b\u0ac7? \u0ab5\u0abe\u0ab0\u0abe\u0aa3\u0ab8\u0ac0, \u0a85\u0aaf\u0acb\u0aa7\u0acd\u0aaf\u0abe, \u0aae\u0a9f\u0acd\u0a9f\u0ac2\u0ab0, \u0ab5\u0ac3\u0a82\u0aa6\u0abe\u0ab5\u0aa8. \u0ae8. \u0a86\u0aaa\u0ac7\u0ab2 \u0a95\u0ac3\u0aa4\u0abf\u0aa8\u0ac1\u0a82 \u0a97\u0abe\u0aae \u0a95\u0aaf\u0abe \u0ab0\u0abe\u0a9c\u0acd\u0aaf\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac1\u0a82 \u0a9b\u0ac7? \u0aae\u0ab9\u0abe\u0ab0\u0abe\u0ab7\u0acd\u0a9f\u0acd\u0ab0, \u0a95\u0ab0\u0acd\u0aa3\u0abe\u0a9f\u0a95, \u0aaa\u0a82\u0a9c\u0abe\u0aac, \u0aa4\u0aae\u0abf\u0ab2\u0aa8\u0abe\u0aa1\u0ac1. \u0ae9. \u0aae\u0a9f\u0acd\u0a9f\u0ac2\u0ab0 \u0a97\u0abe\u0aae\u0aae\u0abe\u0a82 \u0ab2\u0acb\u0a95\u0acb \u0a95\u0a88 \u0aad\u0abe\u0ab7\u0abe\u0aae\u0abe\u0a82 \u0ab5\u0abe\u0aa4\u0a9a\u0ac0\u0aa4 \u0a95\u0ab0\u0aa4\u0abe\u0a82? \u0aae\u0ab0\u0abe\u0aa0\u0ac0, \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4, \u0ab9\u0abf\u0aa8\u0acd\u0aa6\u0ac0, \u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4\u0ac0.",
    "learning_objective": "\u0ab2\u0ac7\u0a96\u0abf\u0aa4 \u0a95\u0acc\u0ab6\u0ab2\u0acd\u0aaf",
    "keywords": [
