[
  {
    "title": "\u0aad\u0abe\u0ab0\u0aa4\u0ac0\u0aaf \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4\u0abf \u0a85\u0aa8\u0ac7 \u0aae\u0a9f\u0acd\u0a9f\u0ac2\u0ab0 \u0a97\u0abe\u0aae\u0aa8\u0acb \u0aaa\u0ab0\u0abf\u0a9a\u0aaf",
    "content": "\u0aad\u0abe\u0ab0\u0aa4\u0ac0\u0aaf \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4\u0abf, \u0aad\u0abe\u0ab0\u0aa4 \u0a97\u0abe\u0aae\u0aa1\u0abe\u0a82\u0aa8\u0acb \u0aac\u0aa8\u0ac7\u0ab2\u0acb \u0aa6\u0ac7\u0ab6, \u0aa6\u0a95\u0acd\u0ab7\u0abf\u0aa3 \u0aad\u0abe\u0ab0\u0aa4\u0aa8\u0ac1\u0a82 \u0a8f\u0a95 \u0ab5\u0abf\u0ab6\u0abf\u0ab7\u0acd\u0a9f \u0a97\u0abe\u0aae, \u0aac\u0acb\u0ab2\u0a9a\u0abe\u0ab2\u0aa8\u0ac0 \u0aad\u0abe\u0ab7\u0abe \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4, \u2018\u0aa6\u0ac7\u0ab5\u0aad\u0abe\u0ab7\u0abe\u2019 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0a86\u0aaa\u0aa3\u0ac1\u0a82 \u0a97\u0acc\u0ab0\u0ab5! \u0ab8\u0aae\u0abe\u0a9c \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4\u0abf, \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0abe\u0ab0, \u0ab8\u0ac1\u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4 \u0ab8\u0aae\u0abe\u0a9c \u0a86\u0aa7\u0acd\u0aaf\u0abe\u0aa4\u0acd\u0aae\u0abf\u0a95\u0aa4\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0a9c\u0acb\u0aa1\u0abe\u0aa3.",
    "learning_objective": "\u0aaa\u0acd\u0ab0\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0aa8\u0abe \u0ab8\u0aae\u0a9c\u0ab5\u0ac0",
    "keywords": [
