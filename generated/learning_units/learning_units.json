    "content": "\u0915. \u092e\u093e\u092e\u093e \u092d\u093e\u0902\u091c\u0947 \u0915\u094b '\u092c\u0949\u092e\u094d\u092c\u0947 \u0928\u0947\u091a\u0941\u0930\u0932 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0938\u094b\u0938\u093e\u0907\u091f\u0940' \u0932\u0947 \u0917\u090f \u0915\u094d\u092f\u094b\u0902\u0915\u093f- \u0935\u0939 \u0936\u093f\u0915\u093e\u0930 \u0915\u0940 \u0917\u0908 \u091a\u093f\u095c\u093f\u092f\u093e \u0915\u093e \u0928\u093e\u092e \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0925\u093e\u0964 \u0916. \u0938\u094b\u0928\u0915\u0902\u0920 \u0915\u0947 \u0936\u093f\u0915\u093e\u0930 \u0915\u093e \u092d\u093e\u0902\u091c\u0947 \u092a\u0930 \u0915\u094d\u092f\u093e \u092a\u094d\u0930\u092d\u093e\u0935 \u092a\u095c\u093e? \u0938\u092d\u0940 \u0920\u0940\u0915 \u0939\u0948\u0902\u0964 \u0917. \u092a\u093e\u0920 \u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0939\u0948- \u0938\u0932\u0940\u092e \u0905\u0932\u0940 \u0915\u0947 \u091c\u0940\u0935\u0928 \u0938\u0947 \u092a\u094d\u0930\u0947\u0930\u0923\u093e \u0932\u0947\u0928\u093e\u0964",
    "learning_objective": "\u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u094d\u0937\u092e\u0924\u093e",
