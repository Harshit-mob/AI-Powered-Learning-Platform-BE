  {
    "title": "\u0905\u0928\u094b\u0916\u0940 \u0917\u094c\u0930\u0948\u092f\u093e \u0915\u0940 \u092a\u0939\u091a\u093e\u0928",
    "content": "\u0917\u0932\u0947 \u092a\u0930 \u0938\u0941\u0928\u0939\u0930\u093e \u0930\u0902\u0917 \u0925\u093e, \u0938\u0935\u093e\u0932 \u0916\u095c\u093e \u0939\u094b \u0917\u092f\u093e \u0915\u093f \u092f\u0939 \u0917\u094c\u0930\u0948\u092f\u093e \u0928 \u0924\u094b \u0915\u094d\u092f\u093e \u0939\u0948? \u092e\u093e\u0925\u093e \u0916\u0941\u091c\u093e\u0924\u0947 \u091a\u093f\u095c\u093f\u092f\u093e \u0915\u094b \u0909\u0932\u091f-\u092a\u0932\u091f\u0915\u0930 \u0926\u0942\u0938\u0930\u0947 \u092c\u091a\u094d\u091a\u094b\u0902 \u0928\u0947 \u092d\u0940 \u0926\u0947\u0916\u093e, \u0932\u0947\u0915\u093f\u0928 \u0938\u0941\u0928\u0939\u0930\u093e \u0930\u0902\u0917 \u0925\u093e\u0964",
    "learning_objective": "\u092a\u094d\u0930\u0915\u0943\u0924\u093f \u092e\u0947\u0902 \u0935\u093f\u0935\u093f\u0927\u0924\u093e \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0915\u0930\u0928\u093e \u0914\u0930 \u090f\u0915 \u0905\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0917\u094c\u0930\u0948\u092f\u093e \u0915\u094b \u0926\u0947\u0916\u0915\u0930 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0939\u0941\u0908 \u091c\u093f\u091c\u094d\u091e\u093e\u0938\u093e \u0915\u094b \u0938\u092e\u091d\u0928\u093e\u0964",
