    "content": "\u0909\u0938\u0940 \u0926\u093f\u0928 \u0909\u0938 \u092d\u093e\u0928\u091c\u0947 \u0928\u0947 \u0920\u093e\u0928 \u0932\u0940 \u0915\u093f \u0935\u0939 \u092a\u0902\u091b\u093f\u092f\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u094d\u092f\u093e\u0926\u093e \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u091c\u093e\u0928\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0917\u093e\u0964 \u092c\u0949\u092e\u094d\u092c\u0947 \u0928\u0947\u091a\u0941\u0930\u0932 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0938\u094b\u0938\u093e\u0907\u091f\u0940 \u0938\u0947 \u091c\u0941\u095c\u0915\u0930 \u092a\u0915\u094d\u0937\u0940 \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e \u092c\u0928 \u0917\u090f\u0964",
