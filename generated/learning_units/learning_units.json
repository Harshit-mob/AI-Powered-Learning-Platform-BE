    "content": "\u0a9c\u0ac0\u0ab5\u0aa8\u0aae\u0abe\u0a82 \u0aa8\u0ac7 \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0ab5\u0abe\u0ab8\u0aa8\u0ac1\u0a82 \u0a96\u0ac2\u0aac \u0a9c \u0aae\u0ab9\u0aa4\u0acd\u0ab5 \u0a9b\u0ac7. \u0aaa\u0acd\u0ab0\u0ab5\u0abe\u0ab8\u0aae\u0abe\u0a82 \u0a86\u0aaa\u0aa3\u0ac7 \u0aae\u0acb\u0a9f\u0ac7\u0aad\u0abe\u0a97\u0ac7 \u0aa7\u0abe\u0ab0\u0acd\u0aae\u0abf\u0a95, \u0a90\u0aa4\u0abf\u0ab9\u0abe\u0ab8\u0abf\u0a95 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0abe\u0a95\u0ac3\u0aa4\u0abf\u0a95 \u0ab8\u0acd\u0aa5\u0ab3\u0acb\u0aa8\u0ac0 \u0aae\u0ac1\u0ab2\u0abe\u0a95\u0abe\u0aa4 \u0ab2\u0a88\u0a8f \u0a9b\u0ac0\u0a8f. \u0aaa\u0acd\u0ab0\u0ab5\u0abe\u0ab8\u0ac7 \u0a9c\u0a88\u0a8f \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a86\u0aaa\u0aa3\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a93\u0ab3\u0a96\u0aaa\u0aa4\u0acd\u0ab0\u0acb, \u0ab8\u0abe\u0aae\u0abe\u0aa8 \u0a85\u0aa8\u0ac7 \u0a9a\u0ac0\u0a9c\u0ab5\u0ab8\u0acd\u0aa4\u0ac1\u0a93 \u0aa4\u0ac7\u0aae\u0a9c \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0abe \u0aac\u0ac2\u0a9f-\u0a9a\u0a82\u0aaa\u0ab2 \u0a95\u0ac7 \u0a95\u0aaa\u0aa1\u0abe\u0a82 \u0ab5\u0a97\u0ac7\u0ab0\u0ac7 \u0ab8\u0abe\u0a82\u0aad\u0ab3\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab0\u0abe\u0a96\u0ab5\u0abe \u0a9c\u0acb\u0a88\u0a8f.",
    "learning_objective": "\u0aaa\u0acd\u0ab0\u0ab5\u0abe\u0ab8 \u0ab5\u0abf\u0ab6\u0ac7\u0aa8\u0ac1\u0a82 \u0ab5\u0ab0\u0acd\u0aa3\u0aa8 \u0ab8\u0aae\u0a9c\u0ab5\u0ac1\u0a82.",
