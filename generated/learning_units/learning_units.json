    "content": "\u0a85\u0aae\u0ac1\u0a95 \u0a9c \u0aaa\u0acd\u0ab0\u0abe\u0aa3\u0ac0, \u0aaa\u0aa6\u0abe\u0ab0\u0acd\u0aa5 \u0a95\u0ac7 \u0ab8\u0acd\u0aa5\u0ab3\u0aa8\u0acb, \u0a95\u0ac7 \u0a95\u0acb\u0a88 \u0a8f\u0a95 \u0ab5\u0ab0\u0acd\u0a97\u0aa8\u0ac0 \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0ab8\u0acd\u0aa4\u0ac1\u0aa8\u0acb \u0aa8\u0abf\u0ab0\u0acd\u0aa6\u0ac7\u0ab6 \u0a95\u0ab0\u0aa8\u0abe\u0ab0\u0ac0 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0ab5\u0abe\u0a9a\u0a95 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe \u0a95\u0ab9\u0ac7 \u0a9b\u0ac7. \u0a9c\u0ac7\u0aae \u0a95\u0ac7, \u0ab0\u0abe\u0aae, \u0ab2\u0a95\u0acd\u0ab7\u0acd\u0aae\u0aa3, \u0ab8\u0ac0\u0aa4\u0abe, \u0aa8\u0ab0\u0acd\u0aae\u0aa6\u0abe, \u0a97\u0a82\u0a97\u0abe, \u0a85\u0aae\u0aa6\u0abe\u0ab5\u0abe\u0aa6, \u0aaa\u0abe\u0ab2\u0aa8\u0aaa\u0ac1\u0ab0, \u0ab8\u0ac1\u0ab0\u0aa4, \u0a97\u0abf\u0ab0\u0aa8\u0abe\u0ab0 \u0ab5\u0a97\u0ac7\u0ab0\u0ac7...",
