  {
    "title": "\u0936\u093f\u0915\u093e\u0930 \u0915\u093e \u0915\u094d\u0937\u0923",
    "content": "\u0909\u0938 \u0926\u093f\u0928 \u0938\u0941\u092c\u0939 \u092a\u093e\u0938 \u0939\u0940 \u092e\u0941\u0902\u0921\u0947\u0930 \u092a\u0930 \u090f\u0915 \u0917\u094c\u0930\u0948\u092f\u093e \u0906 \u092c\u0948\u0920\u0940 \u0925\u0940\u0964 \u092d\u093e\u0902\u091c\u0947 \u0915\u094b \u0932\u0917\u093e \u0915\u093f \u0936\u093f\u0915\u093e\u0930 \u0916\u0941\u0926 \u091a\u0932\u0915\u0930 \u0906 \u0917\u092f\u093e \u0939\u0948, \u0924\u094b \u092b\u093f\u0930 \u0915\u094d\u092f\u093e \u0925\u093e, \u0918\u0930 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0938\u0947 \u0926\u094c\u095c\u0915\u0930 \u0917\u0928 \u0932\u0947 \u0906\u090f, \u0928\u093f\u0936\u093e\u0928\u093e \u0938\u093e\u0927\u093e \u0914\u0930 \u091a\u093f\u095c\u093f\u092f\u093e \u0928\u0940\u091a\u0947\u0964",
