[
  {
    "title": "\u0917\u0928 \u0938\u0947 \u0926\u094b\u0938\u094d\u0924\u0940",
    "content": "\u092e\u0947\u0902 \u0917\u0928 \u0938\u0947 \u0916\u0942\u092c \u092f\u093e\u0930\u0940 \u092d\u0940 \u0939\u094b \u0917\u0908\u0964 \u091c\u092c \u0906\u0938\u092a\u093e\u0938 \u0928\u093f\u0936\u093e\u0928\u0947\u092c\u093e\u091c\u0940 \u0915\u0947 \u092e\u0941\u0915\u093e\u092c\u0932\u0947 \u0939\u094b\u0924\u0947 \u0925\u0947, \u0924\u092c \u0909\u0928\u092e\u0947\u0902 \u092d\u093e\u0917 \u0932\u0947\u0928\u0947 \u0909\u0921\u093c\u093e\u0928\u0947-\u092d\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0925\u093e\u0964 \u0917\u0928 \u0938\u0947 \u0938\u094b\u0932\u0939 \u0906\u0928\u093e \u0938\u091f\u0940\u0915 \u0928\u093f\u0936\u093e\u0928\u093e \u0932\u0917\u0924\u093e \u0925\u093e\u0964",
    "learning_objective": "\u092a\u093e\u0920 \u0915\u0947 \u092e\u0941\u0916\u094d\u092f \u092a\u093e\u0924\u094d\u0930 (\u092d\u093e\u0928\u091c\u0947) \u0915\u0947 \u0917\u0928 \u0938\u0947 \u091c\u0941\u095c\u093e\u0935 \u0914\u0930 \u0928\u093f\u0936\u093e\u0928\u0947\u092c\u093e\u091c\u0940 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0909\u0938\u0915\u0947 \u092c\u091a\u092a\u0928 \u0915\u0947 \u0936\u094c\u0915 \u0915\u094b \u0938\u092e\u091d\u0928\u093e\u0964",
    "keywords": [
