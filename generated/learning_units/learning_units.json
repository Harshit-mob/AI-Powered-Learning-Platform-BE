  },
  {
    "title": "\u0ab6\u0acd\u0ab2\u0acb\u0a95 \u0a97\u0abe\u0aa8",
    "content": "\u0ae7. \u0aa6\u0ac0\u0aaa\u0a9c\u0acd\u0aaf\u0acb\u0aa4\u0abf\u0a83 \u0aaa\u0ab0\u0aac\u0acd\u0ab0\u0ab9\u0acd\u0aae \u0aa6\u0ac0\u0aaa\u0a9c\u0acd\u0aaf\u0acb\u0aa4\u0abf\u0ab0\u0acd\u0a9c\u0ab0\u0acd\u0aa6\u0aa8\u0a83 \u0964 \u0aa6\u0ac0\u0aaa\u0acb \u0ab9\u0ab0\u0aa4\u0ac1 \u0aae\u0ac7 \u0aaa\u0abe\u0aaa\u0a82 \u0aa6\u0ac0\u0aaa\u0a9c\u0acd\u0aaf\u0acb\u0aa4\u0abf\u0ab0\u0acd\u0aa8\u0aae\u0acb\u0aa1\u0ab8\u0acd\u0aa4\u0ac1\u0aa4\u0ac7 \u0965 \u0ae8. \u0a95\u0ab0\u0abe\u0a97\u0acd\u0ab0\u0ac7 \u0ab5\u0ab8\u0aa4\u0ac7 \u0ab2\u0a95\u0acd\u0ab7\u0acd\u0aae\u0ac0\u0a83 \u0a95\u0ab0\u0aae\u0aa7\u0acd\u0aaf\u0ac7 \u0ab8\u0ab0\u0ab8\u0acd\u0ab5\u0aa4\u0ac0 \u0964 \u0a95\u0ab0\u0aae\u0ac2\u0ab2\u0ac7 \u0aa4\u0ac1 \u0a97\u0acb\u0ab5\u0abf\u0aa8\u0acd\u0aa6\u0a83 \u0aaa\u0acd\u0ab0\u0aad\u0abe\u0aa4\u0ac7 \u0a95\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0aa8\u0aae\u0acd \u0965",
