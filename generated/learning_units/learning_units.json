  {
    "title": "\u092c\u0949\u092e\u094d\u092c\u0947 \u0928\u0947\u091a\u0941\u0930\u0932 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0938\u094b\u0938\u093e\u0907\u091f\u0940 \u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e",
    "content": "\u092d\u093e\u0902\u091c\u0947 \u0915\u0940 \u092c\u0947\u091a\u0948\u0928\u0940 \u0926\u0947\u0916\u0915\u0930 \u092e\u093e\u092e\u093e \u092d\u0940 \u091a\u093f\u0902\u0924\u093f\u0924 \u0939\u0941\u090f \u0914\u0930 \u0924\u092f \u0915\u093f\u092f\u093e \u0915\u093f \u091a\u0932\u094b \u2018\u092c\u0949\u092e\u094d\u092c\u0947 \u0928\u0947\u091a\u0941\u0930\u0932 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0938\u094b\u0938\u093e\u0907\u091f\u0940\u2019 \u091a\u0932\u0924\u0947 \u0939\u0948\u0902, \u0935\u0939\u093e\u0901 \u0905\u0902\u0917\u094d\u0930\u0947\u091c \u0938\u093e\u0939\u092c \u0921\u092c\u094d\u0932\u0942. \u0938\u0940. \u092e\u093f\u0932\u093e\u0930\u094d\u0921 \u0915\u0947 \u092a\u093e\u0938 \u091c\u0930\u0942\u0930 \u091c\u0935\u093e\u092c \u0939\u094b\u0917\u093e\u0964 \u092e\u093f\u0932\u093e\u0930\u094d\u0921 \u0938\u093e\u0939\u092c \u0928\u0947 \u092d\u0940 \u091a\u093f\u095c\u093f\u092f\u093e \u0915\u094b \u0926\u0947\u0916\u093e, \u0917\u0932\u0947 \u0915\u0947 \u092a\u093e\u0938 \u0938\u0941\u0928\u0939\u0930\u093e \u0930\u0902\u0917 \u092d\u0940 \u0926\u0947\u0916\u093e \u0914\u0930 \u092c\u0924\u093e \u0926\u093f\u092f\u093e \u0915\u093f \u092f\u0939 \u0917\u094c\u0930\u0948\u092f\u093e \u0939\u0940 \u0939\u0948, \u0938\u094b\u0928\u0915\u0902\u0920 \u0917\u094c\u0930\u0948\u092f\u093e\u0964",
    "learning_objective": "\u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u093e",
