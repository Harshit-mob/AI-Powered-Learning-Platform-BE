  {
    "title": "\u0aae\u0a9f\u0ac1\u0ab0 \u0a97\u0abe\u0aae\u0aa8\u0ac0 \u0ab8\u0abe\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4\u0abf\u0a95 \u0a93\u0ab3\u0a96",
    "content": "\u0aa4\u0ac7 \u0a97\u0abe\u0aae\u0aa8\u0ac0 \u0ab6\u0ac7\u0ab0\u0ac0\u0a93\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0ab8\u0abe\u0ab0 \u0aa5\u0aa4\u0abe\u0a82 \u0a86\u0aaa\u0aa3\u0aa8\u0ac7 \u0aa4\u0acd\u0aaf\u0abe\u0a82\u0aa8\u0ac0 \u0ab8\u0abe\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4\u0abf\u0a95 \u0aaa\u0ab0\u0abf\u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf \u0a9c\u0abe\u0aa3\u0ab5\u0abe \u0aae\u0ab3\u0ac7 \u0a9b\u0ac7. \u0aa4\u0ac7 \u0ab6\u0ac7\u0ab0\u0ac0\u0a93\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0ab8\u0abe\u0ab0 \u0aa5\u0aa4\u0abe\u0a82 \u0ab5\u0ac7\u0aa6\u0aae\u0a82\u0aa4\u0acd\u0ab0\u0acb\u0aa8\u0abe \u0a85\u0ab5\u0abe\u0a9c \u0ab8\u0abe\u0a82\u0aad\u0ab3\u0ab5\u0abe \u0aae\u0ab3\u0ac7 \u0a9b\u0ac7. \u0a97\u0ab2\u0ac0\u0a93\u0aae\u0abe\u0a82 \u0ab0\u0aae\u0aa4\u0abe \u0ab0\u0aae\u0aa4\u0abe \u0aac\u0abe\u0ab3\u0a95\u0acb \u0a86\u0aaa\u0aa3\u0aa8\u0ac7 \u0aa7\u0acb\u0aa4\u0ac0 \u0aaa\u0ab9\u0ac7\u0ab0\u0ac7\u0ab2\u0abe \u0aa4\u0ac7\u0aae\u0a9c \u0aae\u0abe\u0aa5\u0abe \u0aaa\u0ab0 \u0ab6\u0abf\u0a96\u0abe \u0ab0\u0abe\u0a96\u0ac7\u0ab2\u0abe \u0aa6\u0ac7\u0a96\u0abe\u0ab6\u0ac7.",
