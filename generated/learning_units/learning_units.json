[
  {
    "title": "\u0aae\u0a9f\u0ac1\u0ab0 \u0a97\u0abe\u0aae\u0aa8\u0ac1\u0a82 \u0aad\u0acc\u0a97\u0acb\u0ab2\u0abf\u0a95 \u0ab8\u0acd\u0aa5\u0abe\u0aa8",
    "content": "\u0aac\u0abe\u0ab3\u0aae\u0abf\u0aa4\u0acd\u0ab0\u0acb, \u0a86\u0aaa\u0aa3\u0abe \u0aad\u0abe\u0ab0\u0aa4\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac1\u0a82 \u0a95\u0ab0\u0acd\u0aa3\u0abe\u0a9f\u0a95\u0aae\u0abe\u0a82 \u0ab5\u0ab8\u0ac7\u0ab2\u0ac1\u0a82 \u0a8f\u0a95 \u0a8f\u0ab5\u0ac1\u0a82 \u0a97\u0abe\u0aae \u0a9b\u0ac7 \u0a9c\u0ac7\u0aa8\u0ac1\u0a82 \u0aa8\u0abe\u0aae \u0aae\u0a9f\u0acd\u0a9f\u0ac1\u0ab0 \u0a9b\u0ac7. \u0aa4\u0ac7 \u0a97\u0abe\u0aae \u0a85\u0aa4\u0abf \u0aa8\u0abf\u0ab0\u0acd\u0aae\u0ab3, \u0ab8\u0acd\u0ab5\u0a9a\u0acd\u0a9b \u0a85\u0aa8\u0ac7 \u0ab8\u0acc\u0a82\u0aa6\u0ab0\u0acd\u0aaf\u0aa5\u0ac0 \u0aad\u0ab0\u0ac7\u0ab2\u0ac1\u0a82 \u0a9b\u0ac7, \u0aa4\u0ac7\u0aae\u0a9c \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4\u0abf\u0aaa\u0acd\u0ab0\u0aa7\u0abe\u0aa8 \u0a85\u0aa8\u0ac7 \u0ab8\u0abe\u0aa6\u0a97\u0ac0\u0aad\u0ab0\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7. \u0aa4\u0ac1\u0a82\u0a97\u0abe \u0aa8\u0aa6\u0ac0\u0aa8\u0abe \u0a95\u0abf\u0aa8\u0abe\u0ab0\u0ac7 \u0a86 \u0aae\u0a9f\u0ac1\u0ab0 \u0a97\u0abe\u0aae \u0a86\u0ab5\u0ac7\u0ab2 \u0a9b\u0ac7.",
    "learning_objective": "\u0a97\u0abe\u0aae\u0aa8\u0ac1\u0a82 \u0aad\u0acc\u0a97\u0acb\u0ab2\u0abf\u0a95 \u0ab8\u0acd\u0aa5\u0abe\u0aa8 \u0a9c\u0abe\u0aa3\u0ab5\u0ac1\u0a82.",
    "keywords": [
