  {
    "title": "\u092a\u0939\u091a\u093e\u0928 \u0915\u0940 \u0926\u0941\u0935\u093f\u0927\u093e",
    "content": "\u092c\u0939\u0930\u0939\u093e\u0932, \u092d\u093e\u0902\u091c\u0947 \u0928\u0947 \u0936\u093f\u0915\u093e\u0930 \u0915\u094b \u0915\u0930\u0940\u092c \u0938\u0947 \u0926\u0947\u0916\u093e, \u0924\u094b \u0915\u094b\u0908 \u0914\u0930 \u091a\u093f\u095c\u093f\u092f\u093e \u0925\u0940\u0964 \u0917\u0932\u0947 \u092a\u0930 \u0938\u0941\u0928\u0939\u0930\u093e \u0930\u0902\u0917 \u0925\u093e, \u0938\u0935\u093e\u0932 \u0916\u095c\u093e \u0939\u094b \u0917\u092f\u093e \u0915\u093f \u092f\u0939 \u0917\u094c\u0930\u0948\u092f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948, \u0924\u094b \u0915\u094d\u092f\u093e \u0939\u0948? \u091a\u093f\u095c\u093f\u092f\u093e \u0915\u094b \u092e\u093e\u092e\u093e \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u092a\u0947\u0936 \u0915\u093f\u092f\u093e \u0917\u092f\u093e, \u0924\u094b \u092e\u093e\u092e\u093e \u092d\u0940 \u092c\u095c\u0947 \u092a\u0936\u094b\u092a\u0947\u0936 \u092e\u0947\u0902 \u092a\u095c \u0917\u090f\u0964 \u0917\u094c\u0930\u0948\u092f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948, \u0915\u0941\u091b \u0914\u0930 \u0939\u0948? \u092d\u093e\u0902\u091c\u0947 \u0915\u094b \u0915\u094d\u092f\u093e \u092c\u0924\u093e\u092f\u093e \u091c\u093e\u090f? \u092c\u0939\u0941\u0924 \u091a\u093f\u095c\u093f\u092f\u093e\u0901 \u0926\u0947\u0916\u0940 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0910\u0938\u0940 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0940\u0902\u0964 \u092d\u093e\u0902\u091c\u0947 \u0928\u0947 \u092c\u095c\u093e \u0926\u0941\u0930\u094d\u0932\u092d \u2018\u091f\u093e\u0907\u092a\u2019 \u0936\u093f\u0915\u093e\u0930 \u0915\u093f\u092f\u093e \u0939\u0948\u0964",
    "learning_objective": "\u0938\u0902\u0935\u093e\u0926 \u0914\u0930 \u091c\u093f\u091c\u094d\u091e\u093e\u0938\u093e \u0915\u093e \u092d\u093e\u0935",
