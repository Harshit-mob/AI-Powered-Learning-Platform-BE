    "content": "\u0ae7. \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0ab5\u0abe\u0a9a\u0a95 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe: \u0a9a\u0acb\u0a95\u0acd\u0a95\u0ab8 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0ab8\u0acd\u0aa4\u0ac1\u0aa8\u0acb \u0aa8\u0abf\u0ab0\u0acd\u0aa6\u0ac7\u0ab6. \u0ae8. \u0a9c\u0abe\u0aa4\u0abf\u0ab5\u0abe\u0a9a\u0a95 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe: \u0ab8\u0aae\u0ab8\u0acd\u0aa4 \u0a9c\u0abe\u0aa4\u0abf\u0aa8\u0ac7 \u0ab2\u0abe\u0a97\u0ac1 \u0aaa\u0aa1\u0aa4\u0ac0 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe. \u0ae9. \u0ab8\u0aae\u0ac2\u0ab9\u0ab5\u0abe\u0a9a\u0a95 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe: \u0ab8\u0aae\u0ac2\u0ab9 \u0a95\u0ac7 \u0a9c\u0aa5\u0acd\u0aa5\u0acb \u0aac\u0aa4\u0abe\u0ab5\u0aa4\u0ac0 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe. \u0aea. \u0aa6\u0acd\u0ab0\u0ab5\u0acd\u0aaf\u0ab5\u0abe\u0a9a\u0a95 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe: \u0aa4\u0acb\u0ab2\u0ac0 \u0a95\u0ac7 \u0aae\u0abe\u0aaa\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0aa4\u0ac7\u0ab5\u0ac0 \u0ab5\u0ab8\u0acd\u0aa4\u0ac1. \u0aeb. \u0aad\u0abe\u0ab5\u0ab5\u0abe\u0a9a\u0a95 \u0ab8\u0a82\u0a9c\u0acd\u0a9e\u0abe: \u0aae\u0aa8\u0aa5\u0ac0 \u0a85\u0aa8\u0ac1\u0aad\u0ab5\u0abe\u0aaf \u0aa4\u0ac7\u0ab5\u0acb \u0aad\u0abe\u0ab5.",
