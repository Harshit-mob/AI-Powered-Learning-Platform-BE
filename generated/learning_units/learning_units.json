    ],
    "summary": "\u092e\u0941\u0916\u094d\u092f \u092a\u093e\u0924\u094d\u0930 \u0915\u093e \u092c\u091a\u092a\u0928 \u092e\u0947\u0902 \u0917\u0928 \u0914\u0930 \u0928\u093f\u0936\u093e\u0928\u0947\u092c\u093e\u091c\u0940 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0917\u0939\u0930\u093e \u0932\u0917\u093e\u0935 \u0914\u0930 \u0905\u092d\u094d\u092f\u093e\u0938 \u0915\u093e \u0935\u0930\u094d\u0923\u0928\u0964",
    "subtopic_title": "\u0917\u0928 \u0938\u0947 \u0926\u094b\u0938\u094d\u0924\u0940"
