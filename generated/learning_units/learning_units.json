    ],
    "summary": "\u0a97\u0abe\u0aae\u0aae\u0abe\u0a82 \u0a86\u0a9c\u0ac7 \u0aaa\u0aa3 \u0aaa\u0acd\u0ab0\u0abe\u0a9a\u0ac0\u0aa8 \u0a97\u0ac1\u0ab0\u0ac1\u0a95\u0ac1\u0ab3 \u0aaa\u0aa6\u0acd\u0aa7\u0aa4\u0abf \u0aae\u0ac1\u0a9c\u0aac \u0a9d\u0abe\u0aa1 \u0aa8\u0ac0\u0a9a\u0ac7 \u0aac\u0ac7\u0ab8\u0ac0\u0aa8\u0ac7 \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.",
    "subtopic_title": "\u0a97\u0ac1\u0ab0\u0ac1\u0a95\u0ac1\u0ab3 \u0aaa\u0ab0\u0a82\u0aaa\u0ab0\u0abe"
  },
  {
    "title": "\u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4 \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3\u0aa8\u0ac0 \u0a9d\u0aa1\u0aaa",
    "content": "\u0aa4\u0acd\u0aaf\u0abe\u0a82\u0aa8\u0abe \u0a97\u0ac1\u0ab0\u0ac1\u0a93 \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab8\u0a82\u0ab8\u0acd\u0a95\u0ac3\u0aa4 \u0aad\u0abe\u0ab7\u0abe \u0ae8\u0ae6 \u0aa6\u0abf\u0ab5\u0ab8\u0aae\u0abe\u0a82 \u0ab6\u0ac0\u0a96\u0ab5\u0abe\u0aa1\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7. \u0aab\u0a95\u0acd\u0aa4 \u0aac\u0abe\u0ab3\u0a95\u0acb\u0a8f \u0aa4\u0acd\u0aaf\u0abe\u0a82 \u0a97\u0ac1\u0ab0\u0ac1\u0a95\u0ac1\u0ab3\u0aae\u0abe\u0a82 \u0ab0\u0ab9\u0ac7\u0ab5\u0ac1\u0a82 \u0aaa\u0aa1\u0ac7.",
    "learning_objective": "\u0aad\u0abe\u0ab7\u0abe \u0ab6\u0ac0\u0a96\u0ab5\u0abe\u0aa8\u0ac0 \u0a95\u0acd\u0ab7\u0aae\u0aa4\u0abe \u0a9c\u0abe\u0aa3\u0ab5\u0ac0.",
