    "learning_objective": "\u092a\u093e\u0920 \u092e\u0947\u0902 \u092a\u094d\u0930\u092f\u0941\u0915\u094d\u0924 \u0915\u0920\u093f\u0928 \u0936\u092c\u094d\u0926\u094b\u0902 \u0915\u0947 \u0905\u0930\u094d\u0925 \u0915\u094b \u0938\u092e\u091d\u0915\u0930 \u0905\u092a\u0928\u0940 \u0936\u092c\u094d\u0926\u093e\u0935\u0932\u0940 \u0915\u093e \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u0915\u0930\u0928\u093e\u0964",
