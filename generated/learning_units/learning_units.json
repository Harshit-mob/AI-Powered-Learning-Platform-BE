[
  {
    "title": "\u092a\u093e\u0920 \u0915\u0940 \u092d\u0942\u092e\u093f\u0915\u093e \u0914\u0930 \u0932\u0915\u094d\u0937\u094d\u092f",
    "content": "\u0907\u0938 \u092a\u093e\u0920 \u0915\u094b \u092a\u095d\u0924\u0947 \u0939\u0941\u090f \u0906\u092a \u0938\u092e\u091d\u0947\u0902\u0917\u0947 \u0915\u093f \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0918\u091f\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0918\u091f\u0928\u093e\u0913\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0915\u094b\u0908 \u092d\u0940 \u090f\u0915 \u0918\u091f\u0928\u093e \u0915\u0948\u0938\u0947 '\u0935\u093f\u0936\u0947\u0937' \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0932\u0947\u0916 \u0936\u0941\u0930\u0942 \u0924\u094b \u0936\u093f\u0915\u093e\u0930 \u0938\u0947 \u0939\u094b\u0924\u093e \u0939\u0948 \u0914\u0930 '\u092a\u094d\u0930\u093e\u0923\u0940 \u092e\u093e\u0924\u094d\u0930 \u0915\u0947 \u0932\u093f\u090f \u0926\u092f\u093e' \u092a\u0930 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u0928\u093f\u0936\u093e\u0928\u0947\u092c\u093e\u091c \u092c\u093e\u0932\u0915 \u0915\u0940 \u091c\u093c\u093f\u0902\u0926\u0917\u0940 \u0915\u0940 \u0926\u093f\u0936\u093e \u090f\u0915\u0926\u092e \u0939\u0940 \u0915\u0948\u0938\u0947 \u092c\u0926\u0932 \u091c\u093e\u0924\u0940 \u0939\u0948 - \u0906\u0907\u090f \u091c\u093e\u0928\u0947\u0902\u0964",
    "learning_objective": "\u092a\u093e\u0920 \u0915\u0947 \u092e\u0941\u0916\u094d\u092f \u0938\u093e\u0930 \u0915\u094b \u0938\u092e\u091d\u0928\u093e",
